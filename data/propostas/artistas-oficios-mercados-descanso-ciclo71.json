  "principios_materiais": [
    {
      "id": "principio:lxxi:1",
      "nome": "Apropriação da autoria",
      "questao": "Uma encomenda produzida por muitos pode ser assinada apenas por quem controla o pagamento."
    },
    {
      "id": "principio:lxxi:2",
      "nome": "Contrato de dependência",
      "questao": "Quem controla abrigo, ferramenta ou alimento pode chamar coerção de favor."
    },
    {
      "id": "principio:lxxi:3",
      "nome": "Pausa e reprodução da vida",
      "questao": "Artistas, técnicos e anfitriões precisam de comida, limpeza e repouso."
    },
    {
      "id": "principio:lxxi:4",
      "nome": "Estoque e materiais",
      "questao": "A promessa de um festival não gera água, tecido, fibra, madeira ou coral."
    },
    {
      "id": "principio:lxxi:5",
      "nome": "Troca desigual",
      "questao": "Moedas, favores e permutas não constituem um sistema comercial universal."
    },
    {
      "id": "principio:lxxi:6",
      "nome": "Proteção de identidades",
      "questao": "Uma ficha de crédito pode ser também cadastro de pessoas perseguidas."
    },
    {
      "id": "principio:lxxi:7",
      "nome": "Cultura não militar",
      "questao": "Uma patrulha pode querer tomar uma música, máscara ou cor para fins táticos."
    },
    {
      "id": "principio:lxxi:8",
      "nome": "Pessoa não é matéria",
      "questao": "Seda, pigmento, corpo e fala de seres sapientes exigem escolha e limites."
    },
    {
      "id": "principio:lxxi:9",
      "nome": "Segurança da produção",
      "questao": "Reparo sem inspeção não implica instrumento ou embarcação funcional."
    },
    {
      "id": "principio:lxxi:10",
      "nome": "Circulação não comprovada",
      "questao": "Compartilhar ofício não prova estrada, porto, contrato, navio ou migração."
    },
    {
      "id": "principio:lxxi:11",
      "nome": "Pluralidade corporal",
      "questao": "Música, imagem e expressão cromática são percebidas de modo diferente por pessoas e povos distintos."
    }
  ],
